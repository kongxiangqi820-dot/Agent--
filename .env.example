# Copy this file to ".env" and fill real values locally.
# Never commit ".env" to Git.

# Required for OpenAI Agents SDK
OPENAI_API_KEY=your_openai_api_key_here

# Required for FastAPI service auth header: X-API-Key
AGENT_API_KEY=your_service_api_key_here

# Optional request timeout for /v1/chat (seconds), default 60
AGENT_RUN_TIMEOUT_SECONDS=60

# Optional for OpenAI-compatible endpoints
OPENAI_BASE_URL=

# Optional alias when using Gemini OpenAI compatibility.
# run-gemini.ps1 will copy GEMINI_API_KEY -> OPENAI_API_KEY when needed.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional for AMap MCP server (sugarforever/amap-mcp-server).
# Used as: AMAP_MAPS_API_KEY=${AMAP_MAPS_API_KEY}
AMAP_MAPS_API_KEY=your_amap_maps_api_key_here

# Optional for GitHub official MCP server.
# Used by agent.gemini.json as:
# Authorization: Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_personal_access_token_here

# Optional for MiniMaxi TTS skill (skills/tts/scripts/minmax_tts.py)
# Preferred key name (official docs): MINIMAX_API_KEY
MINIMAX_API_KEY=your_minimaxi_api_key_here
# Backward compatibility (legacy): MINMAX_API_KEY
MINMAX_API_KEY=

# Optional for Supabase MCP:
# project_ref can scope tools to one Supabase project.
# Example URL: https://mcp.supabase.com/mcp?read_only=true&project_ref=${SUPABASE_PROJECT_REF}
SUPABASE_PROJECT_REF=
